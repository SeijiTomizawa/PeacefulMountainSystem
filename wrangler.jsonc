{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "taizanryu-site",
	"pages_build_output_dir": "dist",
	"compatibility_date": "2026-03-29",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
	},
	"vars": {
		// RESEND_API_KEY は Cloudflare Pages ダッシュボードまたは
		// `wrangler pages secret put RESEND_API_KEY --project-name taizanryu-site` で設定する
		"CONTACT_FROM_EMAIL": "contact@peacefulmountainsystem.com",
		"CONTACT_TO_EMAIL": "uilriku59jp@yahoo.co.jp",
	},
}
