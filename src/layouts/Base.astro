---
import { logoImage, taizanLogo } from "../components/blocks/images";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image = logoImage, noindex = false } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const siteTitle = "泰山流護身術・逮捕術";
const fullTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const siteDescription = description || "東京八王子本部道場";
---
<!DOCTYPE html>
<html lang="ja" data-lang="ja">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{fullTitle}</title>
    <meta name="description" content={siteDescription} />
    <link rel="canonical" href={Astro.url.href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content={siteTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={image} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <!-- hreflang: 単一URLで言語切り替えのため x-default のみ -->
    <link rel="alternate" hreflang="x-default" href={Astro.url.href} />
    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <!-- PWA -->
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#6B1F23">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="泰山流">
    <!-- Language init: run before render to prevent flash -->
    <script is:inline>
      (function() {
        var lang = localStorage.getItem('site-lang') || 'ja';
        document.documentElement.dataset.lang = lang;
        document.documentElement.lang = lang;
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600&family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Yuji+Syuku&display=swap" rel="stylesheet">
  </head>

  <body>
    <header class="site-header">
      <a href="/" class="header-left">
        <div class="logo-box">
          <img src={logoImage} alt="Site Logo" class="logo" />
        </div>
        <div class="site-title-block">
          <span class="l-1"><span class="ja">泰山流護身術・逮捕術</span><span class="en">Peaceful Mountain System</span></span>
          <span class="l-2"><span class="ja">東京八王子本部道場</span><span class="en">Tokyo Hachioji HQ Dojo</span></span>
        </div>
      </a>
      <div class="header-right">
        <button class="lang-btn" id="langBtn" aria-label="Switch language">
          <span class="lang-ja">English</span><span class="lang-en">日本語</span>
        </button>
        <button class="hamburger" id="hamburger" aria-label="メニューを開く" aria-expanded="false">
          <span class="bar"></span>
          <span class="bar"></span>
          <span class="bar"></span>
        </button>
      </div>
    </header>

    <aside class="drawer-menu" id="drawer">
      <button class="close-btn" id="closeBtn" aria-label="メニューを閉じる">&times;</button>
      
      <nav class="drawer-nav">
        <div class="drawer-lang">
          <button class="lang-btn lang-btn--drawer" id="langBtnDrawer" aria-label="Switch language">
            <span class="drawer-lang-ja">
              <span class="drawer-lang-label">日本語</span>
              <span class="drawer-lang-sub">Japanese</span>
            </span>
            <span class="drawer-lang-divider">/</span>
            <span class="drawer-lang-en">
              <span class="drawer-lang-label">English</span>
              <span class="drawer-lang-sub">英語</span>
            </span>
          </button>
        </div>
        <ul>
          <li><a href="/#home"><span class="ja">ホーム</span><span class="en">Home</span></a></li>
          <li><a href="/self-defense"><span class="ja">護身術・逮捕術</span><span class="en">Martial Arts</span></a></li>
          <li><a href="/yoshitsune-ryu"><span class="ja">義経流柔術</span><span class="en">Yoshitsune-ryu Jujutsu</span></a></li>
          <li><a href="/shiatsu"><span class="ja">指圧治療院</span><span class="en">Shiatsu Clinic</span></a></li>
          <li><a href="/testimonials"><span class="ja">治療院お客様の声</span><span class="en">Testimonials</span></a></li>
          <li><a href="/soke"><span class="ja">宗家について</span><span class="en">About the Soke</span></a></li>
          <li><a href="/event-photos"><span class="ja">大会写真</span><span class="en">Event Photos</span></a></li>
          <li><a href="/members"><span class="ja">門下生たち</span><span class="en">Members</span></a></li>
          <li><a href="/affiliated-dojos"><span class="ja">友好関係の道場</span><span class="en">Affiliated Dojos</span></a></li>
          <li><a href="/contact"><span class="ja">お問い合わせ</span><span class="en">Contact Us</span></a></li>
        </ul>
      </nav>
    </aside>

    <div class="overlay" id="overlay"></div>

    <nav class="sidebar-nav" aria-label="メインナビゲーション">
      <ul>
        <li class={currentPath === '/' ? 'active' : ''}>
          <a href="/#home"><span class="ja">ホーム</span><span class="en">Home</span></a>
        </li>
        <li class={currentPath === '/self-defense' ? 'active' : ''}>
          <a href="/self-defense"><span class="ja">護身術・逮捕術</span><span class="en">Martial Arts</span></a>
        </li>
        <li class={currentPath === '/yoshitsune-ryu' ? 'active' : ''}>
          <a href="/yoshitsune-ryu"><span class="ja">義経流柔術</span><span class="en">Yoshitsune-ryu Jujutsu</span></a>
        </li>
        <li class={currentPath === '/shiatsu' ? 'active' : ''}>
          <a href="/shiatsu"><span class="ja">指圧治療院</span><span class="en">Shiatsu Clinic</span></a>
        </li>
        <li class={currentPath === '/testimonials' ? 'active' : ''}>
          <a href="/testimonials"><span class="ja">治療院お客様の声</span><span class="en">Testimonials</span></a>
        </li>
        <li class={currentPath === '/soke' ? 'active' : ''}>
          <a href="/soke"><span class="ja">宗家について</span><span class="en">About the Soke</span></a>
        </li>
        <li class={currentPath === '/event-photos' ? 'active' : ''}>
          <a href="/event-photos"><span class="ja">大会写真</span><span class="en">Event Photos</span></a>
        </li>
        <li class={currentPath === '/members' ? 'active' : ''}>
          <a href="/members"><span class="ja">門下生たち</span><span class="en">Members</span></a>
        </li>
        <li class={currentPath === '/affiliated-dojos' ? 'active' : ''}>
          <a href="/affiliated-dojos"><span class="ja">友好関係の道場</span><span class="en">Affiliated Dojos</span></a>
        </li>
        <li class={currentPath === '/contact' ? 'active' : ''}>
          <a href="/contact"><span class="ja">お問い合わせ</span><span class="en">Contact Us</span></a>
        </li>
      </ul>
    </nav>

    <main>
      <slot />
    </main>

    <section class="global-cta">
      <div class="global-cta-inner reveal">
        <h2><span class="ja">仲間になりませんか</span><span class="en">Join Our Family</span></h2>
        <p><span class="ja">経験・国籍・年齢は問いません。まずは見学・体験稽古からお気軽にどうぞ。</span><span class="en">Experience, nationality, and age are no barrier. Feel free to come watch or try a training session.</span></p>
        <a href="/contact" class="btn-primary"><span class="ja">お問い合わせ</span><span class="en">Contact Us</span></a>
      </div>
    </section>

    <footer class="site-footer">
      <div class="footer-content">
        <a href="/" class="footer-logo">
          <img src={taizanLogo} alt={siteTitle} class="footer-logo-img" />
        </a>
        <p>&copy; {new Date().getFullYear()} {siteTitle}. All Rights Reserved.</p>
        <div class="social-links">
          <a href="https://www.facebook.com/share/17vx8dscbg/" target="_blank" rel="noopener">Facebook</a>
          <a href="https://www.instagram.com/taizanryu" target="_blank" rel="noopener">Instagram</a>
          <a href="https://www.youtube.com/@taizanryu" target="_blank" rel="noopener">YouTube</a>
        </div>
      </div>
    </footer>

    <script>
      // Service Worker registration
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(() => {});
      }
    </script>

    <script>
      // Hamburger Menu Logic
      const hamburger = document.getElementById('hamburger');
      const drawer = document.getElementById('drawer');
      const overlay = document.getElementById('overlay');
      const closeBtn = document.getElementById('closeBtn');

      function toggleMenu() {
        if(drawer && overlay) {
          drawer.classList.toggle('open');
          overlay.classList.toggle('open');
          const isOpen = drawer.classList.contains('open');
          document.body.style.overflow = isOpen ? 'hidden' : '';
          hamburger?.setAttribute('aria-expanded', String(isOpen));
        }
      }

      hamburger?.addEventListener('click', toggleMenu);
      closeBtn?.addEventListener('click', toggleMenu);
      overlay?.addEventListener('click', toggleMenu);

      document.querySelectorAll('.drawer-nav a').forEach(link => {
        link.addEventListener('click', toggleMenu);
      });

      // Scroll Animation (Intersection Observer)
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) entry.target.classList.add('active');
        });
      }, { root: null, rootMargin: '0px', threshold: 0.1 });

      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

      // Language toggle
      const root = document.documentElement;
      const drawerLangBtn = document.getElementById('langBtnDrawer') as HTMLButtonElement | null;

      function applyLang(lang: string) {
        root.dataset.lang = lang;
        root.lang = lang;
        localStorage.setItem('site-lang', lang);
        updateDrawerBtn(lang);
      }

      function updateDrawerBtn(lang: string) {
        if (!drawerLangBtn) return;
        const jaSpan = drawerLangBtn.querySelector('.drawer-lang-ja') as HTMLElement | null;
        const enSpan = drawerLangBtn.querySelector('.drawer-lang-en') as HTMLElement | null;
        if (jaSpan) jaSpan.dataset.active = lang === 'ja' ? 'true' : 'false';
        if (enSpan) enSpan.dataset.active = lang === 'en' ? 'true' : 'false';
      }

      // Sync on load
      const currentLang = root.dataset.lang || 'ja';
      updateDrawerBtn(currentLang);

      document.getElementById('langBtn')?.addEventListener('click', () => {
        applyLang(root.dataset.lang === 'ja' ? 'en' : 'ja');
      });
      drawerLangBtn?.addEventListener('click', () => {
        applyLang(root.dataset.lang === 'ja' ? 'en' : 'ja');
      });
    </script>

  </body>
</html>
