---
import Base from "../layouts/Base.astro";
import images from "../components/blocks/images";

import HeroCarousel from "../components/HeroCarousel.astro";

const dojos = [
  {
    id: "DOJO_01",
    logo: images.logoImage, // TODO: コウジン道場のロゴ画像URLに差し替え
    name: "泰山流柔術 東海岸本部 コウジン道場",
    name_en: "Peaceful Mountain System East Coast KOUJIN Dojo",
    master: "エメリー・マルドロウ師範",
    master_en: "Dojo Sensei Emery Muldrow",
    location: "20 Seaview Avenue Jersey City N.J 07305, USA",
    location_en: "20 Seaview Avenue Jersey City N.J 07305, USA",
    email: "Umfibi@yahoo.com",
    discribe: "私たちは、そのビジョンに100％共感しています。それが「コウジン道場」のスタイルです。混沌としたこの世界において、真の修行とは帯やトロフィーのためではありません。それは、揺るぎない肉体、精神、そして魂の鎧を鍛え上げ、胸を張って歩み、脅威を早期に察知し、街が投げかけるあらゆる事態に対処できるようにすることです。言い訳は通用せず、経歴も問われません。ただ、純粋な可能性を解き放つだけです。",
    discribe_en: "We connect with that vision 100%, KOUJIN dojo style. In a chaotic world, real training isn't about belts or trophies—it's forging unbreakable physical, mental, and spiritual armor so you walk tall, spot threats early, and handle whatever the streets throw at you. No excuses, no backgrounds held against you; just pure potential unlocked.",
    link: "製作中",
  },
  {
    id: "DOJO_02",
    logo: images.logoImage, // TODO: 木鶏塾のロゴ画像URLに差し替え
    name: "天庸流柔術 大阪総本部道場 木鶏塾",
    name_en: "Tenyo-ryu Ju-jutsu Osaka HQ — Mokkei Juku",
    master: "垣本総師範",
    master_en: "Grandmaster Kakimoto",
    location: "大阪府大阪市北区天満",
    location_en: "Tenma, Kita-ku, Osaka, Japan",
    email: "",
    discribe: "力や身体の大きさに関係なく、一人ひとりのポテンシャルの向上を目的とした稽古を行ってります。",
    discribe_en: "Training focused on developing each individual's potential, regardless of strength or body size.",
    link: "https://mokkeijuku.com/",
  },
  {
    id: "DOJO_03",
    logo: images.logoImage, // TODO: 天庸流東京支部のロゴ画像URLに差し替え
    name: "天庸流柔術　東京支部",
    name_en: "Tenyo-ryu Ju-jutsu — Tokyo Branch",
    master: "齊藤師範",
    master_en: "Sensei Saito",
    location: "東京調布・三鷹・荻窪",
    location_en: "Chofu, Mitaka & Ogikubo, Tokyo",
    email: "",
    discribe: "体操や指圧も行い、お互いに健康になれてしまうというお得な集まりですので、初心者の方もぜひ、気軽にご参加ください。",
    discribe_en: "We also incorporate gymnastics and shiatsu, making it a rewarding gathering where everyone improves their health together. Beginners are warmly welcome.",
    link: "https://9f0sw.hp.peraichi.com/",
  },
];
---

<Base
  title="友好関係の道場 | 泰山流護身術・逮捕術 東京八王子本部道場"
  description="世界各国から集まった仲間たちが、守破離の精神のもとで共に稽古に励んでいます。国籍・年齢・経験を超えた絆が、泰山流道場を一層豊かなものにしています。"
>
  <!-- ヒーロー -->
  <HeroCarousel images={images.selfDefenseHeroBgs.slice(0, 2)} alt="泰山流護身術" shuffle interval={6000}>
    <p class="sd-eyebrow">Taizan-ryu</p>
    <h1 class="sh-hero-title">
      <span class="line-a">
        <span class="ja">友好関係の道場</span>
        <span class="en">Affiliated Dojos</span>
      </span>
    </h1>
    <p class="sd-hero-sub">
      <span class="ja">
        世界各国から集まった仲間たちが、守破離の精神のもとで共に稽古に励んでいます。<br>
        国籍・年齢・経験を超えた絆が、泰山流道場を一層豊かなものにしています。
      </span>
      <span class="en">
        Students from around the world train together in the spirit of Shu-Ha-Ri.<br>
        Bonds that transcend nationality, age, and experience make Taizan-ryu Dojo all the richer.
      </span>
    </p>
  </HeroCarousel> 

  <!-- リストセクション -->
  <section class="list">
    <div class="inner">

      <div class="list-header reveal">
        <h2><span class="ja">友好関係の道場一覧</span><span class="en">Affiliated Dojos</span></h2>
        <p><span class="ja">友好関係の道場をご紹介します。</span><span class="en">Meet our affiliated dojos.</span></p>
      </div>

      <div class="grid">
        {dojos.map((dojo) => (
          <div class="card">
            <div class="card-logo">
              <img
                src={dojo.logo}
                alt={dojo.name}
              />
            </div>
            <div class="card-body surface-light">
              <h3 class="card-name">
                <span class="ja">{dojo.name}</span>
                <span class="en">{dojo.name_en}</span>
              </h3>
              <p class="card-master">
                <span class="ja">{dojo.master}</span>
                <span class="en">{dojo.master_en}</span>
              </p>
              <p class="card-location">
                <span class="ja">{dojo.location}</span>
                <span class="en">{dojo.location_en}</span>
              </p>
              {dojo.email && (
                <a href={`mailto:${dojo.email}`} class="card-email">{dojo.email}</a>
              )}
              <p class="card-description">
                <span class="ja">{dojo.discribe}</span>
                <span class="en">{dojo.discribe_en}</span>
              </p>
              {dojo.link.startsWith('http') ? (
                <a href={dojo.link} target="_blank" rel="noopener noreferrer" class="btn">
                  <span class="ja">ウェブページに行く</span><span class="en">Visit Page</span>
                </a>
              ) : (
                <p class="card-under-construction">
                  <span class="ja">製作中</span><span class="en">Web site under construction.</span>
                </p>
              )}
            </div>
          </div>
        ))}

      </div>
    </div>
  </section>

</Base>

<style>
  /* ===== 共通 ===== */
  .inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ===== タイトルセクション ===== */
  .title {
    padding: calc(var(--header-height) + 80px) 0 80px;
    background-color: var(--bg-color);
    text-align: center;
  }

  .title-content {
    max-width: 640px;
    margin: 0 auto;
  }

  .eyebrow {
    font-size: 0.8rem;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .title-text {
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 600;
    letter-spacing: 8px;
    line-height: 1;
    margin-bottom: 12px;
  }

  .title-sub {
    font-size: 0.85rem;
    letter-spacing: 5px;
    color: var(--text-secondary);
    margin-bottom: 40px;
  }

  .divider {
    width: 40px;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.3);
    margin: 0 auto 40px;
  }

  .title-desc {
    font-size: 0.95rem;
    line-height: 2;
    color: var(--text-secondary);
  }

  /* ===== ヒーローセクション ===== */
  .hero {
    position: relative;
    width: 100%;
    height: 60vh;
    min-height: 360px;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(107, 31, 35, 0.3) 0%,
      rgba(0, 0, 0, 0.5) 100%
    );
  }

  /* ===== リストセクション ===== */
  .list {
    padding: 100px 0;
    background-color: var(--bg-color);
  }

  .list-header {
    text-align: center;
    margin-bottom: 64px;
  }

  .list-header h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 400;
    letter-spacing: 4px;
    margin-bottom: 14px;
  }

  .list-header p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    letter-spacing: 1px;
  }

  /* カードリスト */
  .grid {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* カード（横並び） */
  .card {
    display: grid;
    grid-template-columns: 300px 1fr;
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    overflow: hidden;
    transition: box-shadow 0.4s ease, border-color 0.4s ease;
  }

  .card:hover {
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
    border-color: rgba(255, 255, 255, 0.16);
  }

  /* カードロゴ */
  .card-logo {
    min-height: 260px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 32px;
    background-color: rgba(0, 0, 0, 0.25);
  }

  .card-logo img {
    width: 100%;
    max-width: 200px;
    height: auto;
    object-fit: contain;
    opacity: 0.85;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .card:hover .card-logo img {
    opacity: 1;
    transform: scale(1.04);
  }

  /* カード本文 */
  .card-body {
    padding: 36px 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
  }

  .card-name {
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 2px;
    line-height: 1.6;
  }

  .card-under-construction {
    font-size: 0.8rem;
    letter-spacing: 1.5px;
    color: var(--text-secondary);
    opacity: 0.6;
    margin-top: 8px;
  }

  .card-master {
    font-size: 0.85rem;
    color: var(--text-secondary);
    letter-spacing: 1.5px;
  }

  .card-location {
    font-size: 0.82rem;
    color: var(--text-secondary);
    letter-spacing: 1px;
  }

  .card-email {
    font-size: 0.82rem;
    color: var(--text-secondary);
    letter-spacing: 0.5px;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .card-email:hover {
    color: var(--text-primary);
  }

  .card-description {
    font-size: 0.9rem;
    line-height: 2;
    color: var(--text-secondary);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    margin-top: 8px;
    padding: 10px 28px;
    background-color: #38bdf8;
    color: #0f172a;
    border-radius: 30px;
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.5px;
    transition: background-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }

  .btn:hover {
    background-color: #7dd3fc;
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(56, 189, 248, 0.3);
  }

  /* ===== CTA ===== */
  .cta {
    padding: 100px 0;
    background-color: #1a120d;
    text-align: center;
  }

  .cta h2 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 400;
    letter-spacing: 4px;
    margin-bottom: 20px;
  }

  .cta p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-bottom: 40px;
    line-height: 1.8;
  }


  /* ===== レスポンシブ ===== */
  @media (max-width: 900px) {
    .inner {
      padding: 0 20px;
    }

    .title {
      padding: calc(var(--header-height) + 48px) 0 60px;
    }

    .list,
    .cta {
      padding: 60px 0;
    }

    .card {
      grid-template-columns: 220px 1fr;
    }

    .card-body {
      padding: 24px;
    }
  }

  @media (max-width: 640px) {
    .card {
      grid-template-columns: 1fr;
    }

    .card-logo {
      min-height: 200px;
      padding: 28px 24px;
    }

    .hero {
      height: 45vh;
    }

    .grid {
      gap: 24px;
    }
  }
</style>

<style is:global>
  .hero-carousel .sd-hero-sub {
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    letter-spacing: 2px;
    line-height: 1.9;
  }
</style>
