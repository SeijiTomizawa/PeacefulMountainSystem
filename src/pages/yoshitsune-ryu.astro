<script>
  const audio = document.getElementById("tribute-music-audio") as HTMLAudioElement | null;
  const toggle = document.getElementById("tribute-music-toggle") as HTMLButtonElement | null;
  const seek = document.getElementById("tribute-music-seek") as HTMLInputElement | null;
  const currentLabel = document.querySelector(".sd-music-current");
  const durationLabel = document.querySelector(".sd-music-duration");

  function formatTime(sec: number): string {
    if (!isFinite(sec) || sec < 0) return "0:00";
    const m = Math.floor(sec / 60);
    const s = Math.floor(sec % 60)
      .toString()
      .padStart(2, "0");
    return `${m}:${s}`;
  }

  if (audio && toggle && seek) {
    // MP3の duration はロード直後は推定値のことが多く、後から durationchange で
    // 正しい値に補正される。seek.max にスナップショットすると実際の再生位置とズレるため、
    // スライダーは常に 0–1000 の割合として扱い、毎回そのときの audio.duration で計算する。
    const SEEK_RESOLUTION = 1000;
    let isSeeking = false;

    seek.max = String(SEEK_RESOLUTION);

    function updateDurationLabel() {
      if (durationLabel && audio && isFinite(audio.duration)) {
        durationLabel.textContent = formatTime(audio.duration);
      }
    }

    audio.addEventListener("loadedmetadata", updateDurationLabel);
    audio.addEventListener("durationchange", updateDurationLabel);

    audio.addEventListener("timeupdate", () => {
      if (!isSeeking && isFinite(audio.duration) && audio.duration > 0) {
        const pct = audio.currentTime / audio.duration;
        seek.value = String(pct * SEEK_RESOLUTION);
        seek.style.setProperty("--progress", `${pct * 100}%`);
      }
      if (currentLabel) currentLabel.textContent = formatTime(audio.currentTime);
    });

    audio.addEventListener("ended", () => {
      toggle.classList.remove("is-playing");
    });

    toggle.addEventListener("click", () => {
      if (audio.paused) {
        audio.play();
        toggle.classList.add("is-playing");
      } else {
        audio.pause();
        toggle.classList.remove("is-playing");
      }
    });

    seek.addEventListener("pointerdown", () => {
      isSeeking = true;
    });
    // pointerup をスライダー自身にだけ紐付けると、指/カーソルが要素外に
    // 出てから離した場合に拾えず isSeeking が true のまま固定され、以後
    // シークバーが再生位置に追従しなくなることがあるため window でも拾う。
    const stopSeeking = () => {
      isSeeking = false;
    };
    seek.addEventListener("pointerup", stopSeeking);
    seek.addEventListener("change", stopSeeking);
    window.addEventListener("pointerup", stopSeeking);
    window.addEventListener("pointercancel", stopSeeking);
    seek.addEventListener("input", () => {
      if (!isFinite(audio.duration) || audio.duration <= 0) return;
      const pct = Number(seek.value) / SEEK_RESOLUTION;
      const newTime = pct * audio.duration;
      audio.currentTime = newTime;
      seek.style.setProperty("--progress", `${pct * 100}%`);
      if (currentLabel) currentLabel.textContent = formatTime(newTime);
    });
  }
</script>

