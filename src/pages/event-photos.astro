---
import Base from "../layouts/Base.astro";
import { aichiSeminar, newyorkSeminar } from "../components/blocks/images";

const seminars = [
  {
    id: "aichi-2025",
    titleJa: "愛知セミナー 2025",
    titleEn: "Aichi Seminar 2025",
    dateJa: "2025年",
    location: "愛知県",
    photos: aichiSeminar.filter((_, i) => i !== 9),
  },
  {
    id: "newyork-2023",
    titleJa: "ニューヨークセミナー 2023",
    titleEn: "New York Seminar 2023",
    dateJa: "2023年",
    location: "New York, USA",
    photos: newyorkSeminar,
  },
];

---

<Base
  title="大会写真"
  description="泰山流護身術・逮捕術 — 愛知セミナー・ニューヨークセミナーの様子をご覧ください。"
>

  <!-- ヒーローセクション -->
  <section class="ep-hero">
    <div class="ep-hero-bg" style={`background-image: url(${aichiSeminar[0]})`}></div>
    <div class="ep-hero-overlay"></div>
    <div class="ep-hero-inner reveal">
      <p class="ep-eyebrow">Taizan-ryu</p>
      <h1 class="ep-hero-title"><span class="ja">大会写真</span><span class="en">Event Photos</span></h1>
      <div class="ep-divider"></div>
      <p class="ep-hero-desc ja">セミナー・大会での稽古と演武の記録。</p>
      <p class="ep-hero-desc en">A record of training and demonstrations at seminars and events.</p>
    </div>
  </section>

  <!-- セミナーギャラリーセクション -->
  {seminars.map((seminar, si) => {
    const offset = seminars.slice(0, si).reduce((acc, s) => acc + s.photos.length, 0);
    return (
      <section class={`ep-seminar ${si % 2 === 1 ? "ep-seminar--alt" : ""}`} id={seminar.id}>
        <div class="ep-seminar-inner">
          <div class="ep-seminar-header reveal">
            <div class="ep-seminar-meta">
              <span class="ep-seminar-date">{seminar.dateJa}</span>
              <span class="ep-seminar-sep">—</span>
              <span class="ep-seminar-location">{seminar.location}</span>
            </div>
            <h2 class="ep-seminar-title">
              <span class="ja">{seminar.titleJa}</span>
              <span class="en">{seminar.titleEn}</span>
            </h2>
          </div>

          <div class="ep-masonry">
            {seminar.photos.map((src, i) => {
              const globalIndex = offset + i;
              return (
                <div
                  class="ep-item reveal"
                  data-index={globalIndex}
                  data-src={src}
                  data-alt={`${seminar.titleJa} ${i + 1}`}
                  style={`animation-delay: ${(i % 6) * 80}ms`}
                >
                  <img src={src} alt={`${seminar.titleJa} ${i + 1}`} loading="lazy" />
                  <div class="ep-item-overlay">
                    <span class="ep-item-icon">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                      </svg>
                    </span>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </section>
    );
  })}

  <!-- ライトボックス -->
  <div class="ep-lightbox" id="ep-lightbox" aria-hidden="true">
    <button class="ep-lb-close" id="ep-lb-close" aria-label="閉じる">&times;</button>
    <button class="ep-lb-prev" id="ep-lb-prev" aria-label="前の画像">&#8249;</button>
    <button class="ep-lb-next" id="ep-lb-next" aria-label="次の画像">&#8250;</button>
    <div class="ep-lb-stage">
      <img class="ep-lb-img" id="ep-lb-img" src="" alt="" />
    </div>
    <p class="ep-lb-caption" id="ep-lb-caption"></p>
    <p class="ep-lb-counter" id="ep-lb-counter"></p>
  </div>

</Base>

<script>
  const items    = Array.from(document.querySelectorAll<HTMLElement>('.ep-item'));
  const lightbox  = document.getElementById('ep-lightbox')!;
  const lbImg     = document.getElementById('ep-lb-img') as HTMLImageElement;
  const lbCaption = document.getElementById('ep-lb-caption')!;
  const lbCounter = document.getElementById('ep-lb-counter')!;
  const lbClose   = document.getElementById('ep-lb-close')!;
  const lbPrev    = document.getElementById('ep-lb-prev')!;
  const lbNext    = document.getElementById('ep-lb-next')!;

  let current = 0;

  function open(index: number) {
    current = index;
    const item = items[index];
    lbImg.src = item.dataset.src ?? '';
    lbImg.alt = item.dataset.alt ?? '';
    lbCaption.textContent = item.dataset.alt ?? '';
    lbCounter.textContent = `${index + 1} / ${items.length}`;
    lightbox.classList.add('ep-lightbox--open');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    lightbox.classList.remove('ep-lightbox--open');
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  function prev() { open((current - 1 + items.length) % items.length); }
  function next() { open((current + 1) % items.length); }

  items.forEach((item, i) => item.addEventListener('click', () => open(i)));
  lbClose.addEventListener('click', close);
  lbPrev.addEventListener('click', prev);
  lbNext.addEventListener('click', next);

  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox || (e.target as HTMLElement).classList.contains('ep-lb-stage')) close();
  });

  document.addEventListener('keydown', (e) => {
    if (!lightbox.classList.contains('ep-lightbox--open')) return;
    if (e.key === 'Escape')     close();
    if (e.key === 'ArrowLeft')  prev();
    if (e.key === 'ArrowRight') next();
  });
</script>

<style>
  /* ===== ヒーロー ===== */
  .ep-hero {
    position: relative;
    height: calc(var(--header-height) + 480px);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }

  .ep-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transform: scale(1.05);
    transition: transform 8s ease;
  }

  .ep-hero:hover .ep-hero-bg {
    transform: scale(1.0);
  }

  .ep-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.55) 0%,
      rgba(0, 0, 0, 0.65) 60%,
      rgba(0, 0, 0, 0.85) 100%
    );
  }

  .ep-hero-inner {
    position: relative;
    z-index: 1;
    padding: calc(var(--header-height) + 20px) 24px 48px;
    max-width: 600px;
    margin: 0 auto;
  }

  .ep-eyebrow {
    font-size: 0.75rem;
    letter-spacing: 6px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 20px;
  }

  .ep-hero-title {
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 600;
    letter-spacing: 8px;
    line-height: 1;
    margin-bottom: 32px;
  }

  .ep-divider {
    width: 40px;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.3);
    margin: 0 auto 28px;
  }

  .ep-hero-desc {
    font-size: 0.9rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 1px;
  }

  /* ===== セミナーセクション ===== */
  .ep-seminar {
    padding: 80px 0 100px;
    background-color: var(--bg-color);
  }

  .ep-seminar--alt {
    background-color: var(--surface-dark, #111);
  }

  .ep-seminar-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .ep-seminar-header {
    margin-bottom: 48px;
    text-align: center;
  }

  .ep-seminar-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-size: 0.78rem;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 16px;
  }

  .ep-seminar-sep {
    opacity: 0.4;
  }

  .ep-seminar-title {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 600;
    letter-spacing: 4px;
    line-height: 1.2;
  }

  /* ===== マソンリーグリッド ===== */
  .ep-masonry {
    column-count: 3;
    column-gap: 12px;
  }

  .ep-item {
    break-inside: avoid;
    margin-bottom: 12px;
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
                box-shadow 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .ep-item img {
    width: 100%;
    display: block;
    transition: transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1),
                filter 0.55s ease;
    filter: brightness(0.95) saturate(1.05);
  }

  /* 下からフェードするグラデーションオーバーレイ */
  .ep-item-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(107, 31, 35, 0.75) 0%,
      rgba(107, 31, 35, 0.15) 45%,
      transparent 70%
    );
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 16px 18px;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  /* 虫眼鏡アイコン（SVG） */
  .ep-item-icon {
    width: 36px;
    height: 36px;
    border: 1.5px solid rgba(255, 255, 255, 0.8);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 1rem;
    flex-shrink: 0;
    transform: translateY(8px);
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .ep-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.55);
  }

  .ep-item:hover img {
    transform: scale(1.07);
    filter: brightness(1.05) saturate(1.15);
  }

  .ep-item:hover .ep-item-overlay {
    opacity: 1;
  }

  .ep-item:hover .ep-item-icon {
    transform: translateY(0);
  }

  /* ===== ライトボックス ===== */
  .ep-lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    background-color: rgba(0, 0, 0, 0.95);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .ep-lightbox--open {
    opacity: 1;
    visibility: visible;
  }

  .ep-lb-stage {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    flex: 1;
    padding: 60px 80px 20px;
    box-sizing: border-box;
  }

  .ep-lb-img {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
    transition: opacity 0.2s ease;
  }

  .ep-lb-caption {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
    letter-spacing: 2px;
    margin: 0 0 8px;
    text-align: center;
  }

  .ep-lb-counter {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.4);
    letter-spacing: 2px;
    margin: 0 0 24px;
  }

  .ep-lb-close {
    position: absolute;
    top: 20px;
    right: 24px;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.7);
    font-size: 2.5rem;
    cursor: pointer;
    line-height: 1;
    padding: 8px;
    transition: color 0.2s ease, transform 0.2s ease;
    z-index: 10;
  }

  .ep-lb-close:hover {
    color: #fff;
    transform: scale(1.1);
  }

  .ep-lb-prev,
  .ep-lb-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #fff;
    font-size: 2rem;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease;
    z-index: 10;
  }

  .ep-lb-prev { left: 20px; }
  .ep-lb-next { right: 20px; }

  .ep-lb-prev:hover,
  .ep-lb-next:hover {
    background: rgba(255, 255, 255, 0.18);
  }

  /* ===== レスポンシブ ===== */
  @media (max-width: 1024px) {
    .ep-masonry { column-count: 2; }
  }

  @media (max-width: 600px) {
    .ep-hero {
      height: calc(var(--header-height) + 360px);
    }

    .ep-seminar {
      padding: 56px 0 72px;
    }

    .ep-seminar-inner {
      padding: 0 12px;
    }

    .ep-seminar-header {
      margin-bottom: 32px;
    }

    .ep-masonry {
      column-count: 2;
      column-gap: 8px;
    }

    .ep-item {
      margin-bottom: 8px;
      border-radius: 10px;
    }

    .ep-lb-stage { padding: 60px 16px 16px; }
    .ep-lb-prev  { left: 8px; }
    .ep-lb-next  { right: 8px; }
    .ep-lb-prev,
    .ep-lb-next  { width: 40px; height: 40px; font-size: 1.4rem; }
  }
</style>
