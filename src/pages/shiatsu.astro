  // 経絡アコーディオン：ひとつ開くと他は自動的に閉じる
  const meridianItems = document.querySelectorAll<HTMLDetailsElement>(".sh-meridian-item");
  meridianItems.forEach((item) => {
    item.addEventListener("toggle", () => {
      if (!item.open) return;
      meridianItems.forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });
