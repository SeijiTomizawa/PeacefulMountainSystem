---
import Base from "../layouts/Base.astro";
import { getR2PosterUrl, getR2VideoUrl, shiatsuTestimonialsData } from "../components/blocks/videos";
import { clientLetters, shiatsuImages } from "../components/blocks/images";

const testimonialVideos = [...shiatsuTestimonialsData].sort((a, b) => {
  const aOrder = a.order ?? 0;
  const bOrder = b.order ?? 0;
  if (aOrder > 0 && bOrder > 0) return aOrder - bOrder;
  if (aOrder > 0) return -1;
  if (bOrder > 0) return 1;
  return a.id - b.id;
});
---

<Base
  title="治療院お客様の声"
  description="泰山流指圧整体院のお客様の声。慢性痛・肩こり・腰痛など、施術を受けた方々の体験談を動画でご紹介します。"
>

  <!-- ヒーローセクション -->
  <section class="ts-hero">
    <img
      src={shiatsuImages[0]}
      alt="泰山流指圧整体院"
      class="ts-hero-bg"
      fetchpriority="high"
    />
    <div class="ts-hero-overlay"></div>
    <div class="ts-hero-content">
      <p class="ts-eyebrow">Taizan-ryu Shiatsu</p>
      <h1 class="ts-hero-title">
        <span class="ts-line-a"><span class="ja">お客様の声</span><span class="en">Testimonials</span></span>
        <span class="ts-line-b">Taizan-ryu Shiatsu</span>
      </h1>
      <p class="ts-hero-sub"><span class="ja">施術を受けた方々の体験談</span><span class="en">Stories from our clients</span></p>
    </div>
    <div class="ts-hero-scroll"><span></span></div>
  </section>

  <!-- タイトル・リード文 -->
  <section class="ts-lead">
    <div class="ts-inner">
      <div class="ts-lead-content reveal">
        <h2><span class="ja">治療院お客様の声</span><span class="en">Client Testimonials</span></h2>
        <p class="ja">
          泰山流指圧整体院で施術を受けたお客様からのご感想を動画でご紹介します。
          慢性的な痛みや不調でお悩みの方の参考になれば幸いです。
          個人の感想であり、効果を保証するものではありません。
        </p>
        <p class="en">
          Video testimonials from clients who have received treatment at Taizan-ryu Shiatsu Clinic.
          We hope these accounts from those suffering from chronic pain and conditions will be of help.
          These are personal experiences and do not guarantee outcomes.
        </p>
      </div>
    </div>
  </section>

  <!-- 動画 -->
  <section class="ts-videos surface-white">
    <div class="ts-grid-wrap">
      <div class="ts-grid">
        {testimonialVideos.map((v, i) => (
          <div class="ts-item reveal" style={`animation-delay: ${(i % 4) * 80}ms`}>
            <div class="ts-video-wrap">
              <video
                data-src={v.r2File ? getR2VideoUrl("testimonials", v.r2File) : undefined}
                poster={v.r2File ? getR2PosterUrl("testimonials", v.r2File) : undefined}
                title={v.titleJP}
                controls
                preload="none"
                playsinline
              ></video>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- レター -->
  <section class="ts-letters surface-light">
    <div class="ts-grid-wrap">
      <div class="ts-lead-content reveal">
        <h2><span class="ja">お客様からの手紙</span><span class="en">Letters from Clients</span></h2>
        <p class="ja">
          施術を受けたお客様からいただいた感謝の手紙をご紹介します。
          体調が改善した喜びや、日常生活が楽になったという声を多数いただいています。
          個人の感想であり、効果を保証するものではありません。
        </p>
        <p class="en">
          We would like to share some of the heartfelt letters we have received from our clients.
          Many have expressed their joy at improved health and how their daily lives have become easier.
          These are personal experiences and do not guarantee outcomes.
        </p>
      </div>
      <div class="ts-grid reveal">
        {clientLetters.map((letter, i) => (
          <img
            src={letter}
            alt={`お客様からの手紙 ${i + 1}`}
            style={`animation-delay: ${(i % 4) * 80}ms`}
            loading="lazy"
          />
        ))}
      </div>
    </div>
  </section>

</Base>

<script>
  const timers = new Map<Element, ReturnType<typeof setTimeout>>();

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        const video = entry.target as HTMLVideoElement;
        const shouldLoad = entry.isIntersecting;

        const existing = timers.get(video);
        if (existing) clearTimeout(existing);

        timers.set(
          video,
          setTimeout(() => {
            timers.delete(video);
            if (shouldLoad) {
              if (video.dataset.src && !video.src) {
                video.src = video.dataset.src;
                video.load();
              }
            } else {
              video.pause();
              video.removeAttribute("src");
              video.load();
            }
          }, 300)
        );
      });
    },
    { rootMargin: "300px 0px" }
  );

  document.querySelectorAll<HTMLVideoElement>("video[data-src]").forEach((el) => {
    observer.observe(el);
  });
</script>

<style>
  /* ===== 共通 ===== */
  .ts-inner {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ===== ヒーロー ===== */
  .ts-hero {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .ts-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .ts-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.35) 0%,
      rgba(30, 20, 10, 0.75) 100%
    );
  }

  .ts-hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: #fff;
    padding: 0 20px;
  }

  .ts-eyebrow {
    font-size: 0.8rem;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: 24px;
    opacity: 0;
    animation: tsFadeUp 0.8s ease 0.2s forwards;
  }

  .ts-hero-title {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 28px;
  }

  .ts-line-a {
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    font-weight: 600;
    letter-spacing: 6px;
    opacity: 0;
    animation: tsFadeUp 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) 0.4s forwards;
  }

  .ts-line-b {
    font-size: clamp(1.4rem, 3.5vw, 2.6rem);
    font-weight: 300;
    letter-spacing: 8px;
    color: rgba(255, 255, 255, 0.75);
    opacity: 0;
    animation: tsFadeUp 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) 0.6s forwards;
  }

  .ts-hero-sub {
    font-size: 0.9rem;
    letter-spacing: 3px;
    color: rgba(255, 255, 255, 0.6);
    opacity: 0;
    animation: tsFadeUp 0.8s ease 0.9s forwards;
  }

  .ts-hero-scroll {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
  }

  .ts-hero-scroll span {
    display: block;
    width: 1px;
    height: 60px;
    background: linear-gradient(to bottom, rgba(255,255,255,0.5), transparent);
    margin: 0 auto;
    transform-origin: top;
    animation: tsScrollLine 2s ease-in-out infinite;
  }

  @keyframes tsFadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes tsScrollLine {
    0%   { transform: scaleY(0); opacity: 1; }
    50%  { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1); opacity: 0; }
  }

  /* ===== リード文 ===== */
  .ts-lead {
    padding: 80px 0;
    background-color: var(--bg-color);
  }

  .ts-lead-content {
    text-align: center;
    max-width: 680px;
    margin: 0 auto;
  }

  .ts-lead-content h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 400;
    letter-spacing: 4px;
    margin-bottom: 28px;
  }

  .ts-lead-content p {
    font-size: 0.9rem;
    line-height: 2;
    color: var(--text-secondary);
  }

  /* ===== 動画ギャラリー ===== */
  .ts-videos {
    padding: 60px 0 100px;
  }

  .ts-grid-wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .ts-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .ts-item {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ts-video-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    border-radius: 8px;
    overflow: hidden;
    background-color: #0a0705;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
    transition: box-shadow 0.4s ease, transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .ts-item:hover .ts-video-wrap {
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.8);
    transform: translateY(-4px);
  }

  .ts-video-wrap video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    object-fit: cover;
    background-color: #0a0705;
  }

  /* ===== レターギャラリー ===== */
  .ts-letters {
    padding: 60px 0 100px;
  }

  .ts-letters .ts-lead-content {
    margin-bottom: 48px;
  }

  .ts-letters .ts-grid img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: center;
    display: block;
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
    transition: box-shadow 0.4s ease, transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .ts-letters .ts-grid img:hover {
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25);
    transform: translateY(-4px);
  }

  /* ===== レスポンシブ ===== */
  @media (max-width: 900px) {
    .ts-inner { padding: 0 20px; }

    .ts-lead { padding: 60px 0; }

    .ts-videos { padding-bottom: 60px; }

    .ts-grid-wrap { padding: 0 16px; }
    .ts-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }

    .ts-line-a { letter-spacing: 4px; }
    .ts-line-b { letter-spacing: 5px; }
  }

  @media (max-width: 560px) {
    .ts-grid { grid-template-columns: repeat(2, 1fr); gap: 8px; }
    .ts-grid-wrap { padding: 0 12px; }
  }
</style>
