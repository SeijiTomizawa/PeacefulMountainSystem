---
import Base from "../layouts/Base.astro";
import { membersGroupImage, logoImage } from "../components/blocks/images";
import { members } from "../data/members";

const now = new Date();
const dateJa = `${now.getFullYear()}年${now.getMonth() + 1}月現在`;
const dateEn = now.toLocaleString('en-US', { month: 'long', year: 'numeric' });

import HeroCarousel from "../components/HeroCarousel.astro";
---

<Base
  title="門下生"
  description="泰山流護身術・逮捕術の門下生たち。世界各国から集まった仲間が、東京八王子本部道場で共に稽古に励んでいます。"
>
  <!-- ヒーロー -->
  <HeroCarousel images={[membersGroupImage]} alt="泰山流門下生" objectPosition="center -70%">
    <p class="sd-eyebrow">Taizan-ryu</p>
    <h1 class="sh-hero-title">
      <span class="line-a">
        <span class="ja">門下生たち</span>
        <span class="en">Members</span>
      </span>
    </h1>
    <p class="sd-hero-sub">
      <span class="ja">世界各国から集まった、泰山流の仲間たち</span>
      <span class="en">Students from around the world, united in Taizanryu</span>
    </p>
  </HeroCarousel> 

  <!-- リストセクション -->
  <section class="mb-list surface-light">
    <div class="mb-inner">
      <div class="mb-list-header reveal">
        <h2><span class="ja">共に稽古を積む仲間たち</span><span class="en">Training Together as One</span></h2>
        <p><span class="ja">{dateJa} - 泰山流護身術認定メンバー</span><span class="en">As of {dateEn} — Taizan-ryu Certified Members</span></p>
      </div>

      <div class="mb-grid">
        {members.map((member) => (
          <div class="mb-card reveal">
            <div class="mb-card-photo">
              <img
                src={member.data.photo_url || logoImage}
                alt={member.data.name}
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="mb-card-body">
              <h3 class="mb-card-name">{member.data.name}</h3>
              <p class="mb-card-name-en">{member.data.member_id}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

</Base>

<style>
  /* ===== 共通 ===== */
  .mb-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ===== リストセクション ===== */
  .mb-list {
    padding: 100px 0;
  }

  .mb-list-header {
    text-align: center;
    margin-bottom: 64px;
  }

  .mb-list-header h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 400;
    letter-spacing: 4px;
    margin-bottom: 14px;
    color: var(--text-primary);
  }

  .mb-list-header p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    letter-spacing: 1px;
  }

  /* カードグリッド */
  .mb-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  /* カード */
  .mb-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 20px;
    background-color: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.07);
    border-radius: 10px;
    padding: 16px;
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
                box-shadow 0.3s ease;
  }

  .mb-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.1);
  }

  /* カード写真 */
  .mb-card-photo {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
    background-color: #f0ebe3;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mb-card-photo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.4s ease;
    filter: grayscale(15%);
  }

  .mb-card:hover .mb-card-photo img {
    transform: scale(1.06);
    filter: grayscale(0%);
  }

  /* カード本文 */
  .mb-card-body {
    flex: 1;
    min-width: 0;
  }

  .mb-card-name {
    font-size: clamp(0.78rem, 3.5vw, 1rem);
    font-weight: 600;
    letter-spacing: clamp(0.5px, 0.4vw, 1.5px);
    margin-bottom: 4px;
    color: var(--text-on-light);
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .mb-card-name-en {
    font-size: 0.75rem;
    color: var(--text-secondary);
    letter-spacing: 1px;
  }

  /* タグ */
  .mb-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 18px;
  }

  .mb-tag {
    font-size: 0.72rem;
    letter-spacing: 1px;
    padding: 3px 10px;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--text-secondary);
  }

  .mb-tag-rank {
    background-color: rgba(107, 31, 35, 0.5);
    border-color: rgba(107, 31, 35, 0.8);
    color: #ffcccc;
  }

  /* 詳細情報 */
  .mb-card-info {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 12px;
    row-gap: 6px;
    font-size: 0.8rem;
  }

  .mb-card-info dt {
    color: var(--text-secondary);
    letter-spacing: 1px;
  }

  .mb-card-info dd {
    color: var(--text-primary);
    margin: 0;
  }

  /* ===== レスポンシブ ===== */
  @media (max-width: 900px) {
    .mb-inner {
      padding: 0 20px;
    }

    .mb-title {
      padding: calc(var(--header-height) + 48px) 0 60px;
    }

    .mb-list,
    .mb-cta {
      padding: 60px 0;
    }

    .mb-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }

  @media (max-width: 600px) {
    .mb-grid {
      grid-template-columns: 1fr;
    }

    .mb-hero {
      height: 45vh;
    }
  }
</style>
